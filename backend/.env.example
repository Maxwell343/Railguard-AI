# RailGuard AI — FastAPI Backend Configuration

# Host and Port
HOST=127.0.0.1
PORT=8000

# Path to trained YOLOv8n weights relative to backend/ directory
WEIGHTS_PATH=weights/railguard_yolov8n_best.pt

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum permissible upload size in bytes (25 MB)
MAX_UPLOAD_SIZE_BYTES=26214440

# Default inference thresholds
DEFAULT_CONFIDENCE=0.45
DEFAULT_IOU=0.45
